@@ -1057,6 +1057,113 @@
   border-top: var(--hairline) solid var(--line);
 }
 
+/* ── the shortcut list (P7-K4) ───────────────────────────────────────────────
+   Help ▸ Keyboard Shortcuts…, ported. The donor's window was 440×600 and
+   monospaced (`ShortcutsWindowController.swift:17`, `ShortcutListView.swift:40`);
+   ours is wider because it carries a third column the donor had no field for —
+   where a chord is live, or `parked`.
+
+   Deliberately the same scrim/dialog shape as `.plane-matrix` rather than a
+   fourth overlay species: both are SUMMONED REFERENCE surfaces you open, read
+   and dismiss, and one vocabulary is the same argument the plane bar's two
+   menus already make. */
+
+.plane-keys-scrim {
+  position: fixed;
+  inset: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: var(--bg);
+  z-index: var(--z-popover);
+}
+
+.plane-keys {
+  width: min(720px, 92vw);
+  max-height: 86vh;
+  overflow: auto;
+  background: var(--bg-raised);
+  border: var(--hairline) solid var(--line);
+  border-radius: var(--radius);
+  padding: 10px;
+}
+
+.plane-keys-head {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding-bottom: 8px;
+  border-bottom: var(--hairline) solid var(--line);
+  /* The head carries the honest ratio and the parked toggle — it must stay put
+     while 99 rows scroll under it, or the count is only true at the top. */
+  position: sticky;
+  top: 0;
+  background: var(--bg-raised);
+}
+
+.plane-keys-head button {
+  min-width: 26px;
+  height: 22px;
+  background: var(--bg);
+  color: var(--text);
+  border: var(--hairline) solid var(--line);
+  border-radius: var(--radius-sm);
+  cursor: pointer;
+}
+
+/* ⚠️ The temporary caption (see `Shortcuts.tsx` DISPATCH_CAVEAT) — WARN, not
+   dim: it is the difference between a list of shortcuts and a list of
+   intentions, and it goes when P7-K1 lands. */
+.plane-keys-caveat {
+  margin: 8px 0 0;
+  color: var(--warn);
+}
+
+.plane-keys-section { margin-top: 14px; }
+
+.plane-keys-section h3 {
+  margin: 0 0 4px;
+  color: var(--text-dim);
+  font-weight: normal;
+}
+
+.plane-keys-table {
+  width: 100%;
+  border-collapse: collapse;
+}
+
+.plane-keys-table td {
+  text-align: left;
+  padding: 2px 6px;
+  border-bottom: var(--hairline) solid var(--line);
+  vertical-align: top;
+}
+
+/* The donor padded this column to 22 characters. A fixed column does the same
+   job without clipping the 35-character piano row. */
+.plane-keys-chord {
+  width: 22ch;
+  white-space: nowrap;
+}
+
+.plane-keys-where {
+  width: 9ch;
+  text-align: right;
+  white-space: nowrap;
+}
+
+/* Parked rows RECEDE — same treatment, and the same reason, as the matrix's
+   default wiring: present, readable, and visibly not the answer. */
+.plane-keys-table tr.is-parked { opacity: 0.45; }
+.plane-keys-table tr.is-parked:hover { opacity: 0.8; cursor: pointer; }
+
+.plane-keys-reason td {
+  color: var(--warn);
+  padding-bottom: 6px;
+}
+
+.plane-keys-note { margin: 6px 0 0; }
+
 /* ── the master section ──────────────────────────────────────────────────── */
 
