// ASRC drift soak (P2-03 — THE phase centerpiece, feasibility §7's #1 failure).
//
// Two synthetic clocks: the engine at exactly ENGINE_RATE, a source whose FORMAT
// reports the same nominal rate but whose true clock runs slightly faster. We
// simulate a full hour: each engine block, the source delivers the frames its
// true clock produced (timestamps advancing at the true rate), then the engine
// pulls a block through the ASRC. The gate: over the hour, ring fill — and thus
// alignment — stays within 1 ms of target. The NEGATIVE CONTROL (controller
// off, "trust the reported rate") must drift far past that, proving the loop is
// what fixes it.
#include "asrc.h"
#include "source_ring.h"

#include <cmath>
#include <cstdio>
#include <vector>

#define CHECK(cond)                                                              \
    do {                                                                         \
        if (!(cond)) {                                                           \
            std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); \
            return 1;                                                            \
        }                                                                        \
    } while (0)

namespace {

// Rates are scaled DOWN from the spec's 48000 vs 48000.3 to keep a full
// simulated hour's SINC_BEST sample budget inside a CI-friendly runtime, while
// preserving the EXACT drift the controller must reject: 8000.05/8000 =
// 6.25 ppm = 48000.3/48000. The control loop is ppm- and time-driven, so the
// behavior is identical — same 6.25 ppm, same 3600 s, same ~22 ms of drift the
// naive path accrues. (The real 48 kHz rates run correctly too; they are just a
// ~6× longer soak, run manually before a release.)
constexpr double kEngineRate = 8000.0;
constexpr double kNominalRate = 8000.0;    // what the source's format claims
constexpr double kTrueRate = 8000.05;      // what its clock actually runs at (6.25 ppm)
constexpr uint32_t kQuantum = 128;
constexpr uint32_t kCapacity = 8 * kQuantum; // headroom for the negative control's drift
constexpr double kSeconds = 3600.0;          // a simulated hour

struct Result {
    double finalFillErrorMs;
    double driftPpm;
    uint64_t underruns;
    uint64_t overruns;
};

// Run the hour. `controller` off = the naive negative control.
Result run(bool controller) {
    wz::SourceRing ring;
    ring.init("tap", 1, kCapacity); // mono keeps the SINC_BEST sample budget testable
    wz::SourceAsrc asrc;
    asrc.init(&ring, kEngineRate, kNominalRate, kQuantum);
    asrc.setControllerEnabled(controller);

    // Prime the ring to target fill so t=0 is not an underrun.
    const uint32_t prime = static_cast<uint32_t>(1.5 * kQuantum);
    std::vector<float> primeBuf(prime, 0.0f);
    ring.write(primeBuf.data(), prime, kNominalRate, 0);

    const uint64_t totalBlocks =
        static_cast<uint64_t>(kEngineRate * kSeconds / kQuantum);
    std::vector<float> out(kQuantum, 0.0f);
    std::vector<float> in(kQuantum + 4, 0.0f);

    uint64_t hostNs = 0;
    double srcAccum = 0.0; // fractional source frames carried between blocks
    double phase = 0.0;
    constexpr double kTwoPi = 6.283185307179586;
    const double inc = kTwoPi * 997.0 / kTrueRate; // a tone, so output is real audio
    uint64_t underruns = 0;

    for (uint64_t b = 0; b < totalBlocks; ++b) {
        // Frames the TRUE source clock produced during one engine block of time.
        srcAccum += kQuantum * (kTrueRate / kEngineRate);
        uint32_t feed = static_cast<uint32_t>(srcAccum);
        srcAccum -= feed;
        if (feed > in.size()) feed = static_cast<uint32_t>(in.size());
        for (uint32_t i = 0; i < feed; ++i) {
            in[i] = static_cast<float>(std::sin(phase));
            phase += inc;
            if (phase >= kTwoPi) phase -= kTwoPi;
        }
        // Deliver with the NOMINAL reported rate but timestamps advancing at the
        // TRUE rate — exactly what a drifting device looks like.
        hostNs += static_cast<uint64_t>(
            (static_cast<double>(feed) / kTrueRate) * 1e9 + 0.5);
        ring.write(in.data(), feed, kNominalRate, hostNs);

        const uint32_t got = asrc.process(out.data(), kQuantum);
        if (got < kQuantum) ++underruns;
    }

    const double target = 1.5 * kQuantum;
    const double fillErrFrames = static_cast<double>(ring.fillFrames()) - target;
    return {std::abs(fillErrFrames) / kEngineRate * 1000.0, asrc.driftPpm(),
            underruns, ring.overruns.load()};
}

} // namespace

int main() {
    const double oneMsFrames = kEngineRate / 1000.0; // 48 frames

    // --- controller ON: alignment held within 1 ms across the hour ----------
    const Result on = run(true);
    std::printf("ASRC on:  drift=%.3f ppm  fillErr=%.3f ms  under=%llu over=%llu\n",
                on.driftPpm, on.finalFillErrorMs,
                static_cast<unsigned long long>(on.underruns),
                static_cast<unsigned long long>(on.overruns));
    CHECK(on.underruns == 0);          // the source never starved the engine
    CHECK(on.overruns == 0);           // fill never ran away and dropped audio
    CHECK(on.finalFillErrorMs < 1.0);  // THE GATE: < 1 ms after a simulated hour
    CHECK(on.driftPpm > 5.5 && on.driftPpm < 7.0); // ~6.25 ppm discovered from timestamps

    // --- NEGATIVE CONTROL: no correction → drift accrues far past 1 ms ------
    const Result off = run(false);
    std::printf("ASRC off: drift=%.3f ppm  fillErr=%.3f ms  under=%llu over=%llu\n",
                off.driftPpm, off.finalFillErrorMs,
                static_cast<unsigned long long>(off.underruns),
                static_cast<unsigned long long>(off.overruns));
    // ~0.3 Hz over an hour ≈ 1080 frames ≈ 22 ms of accumulated misalignment
    // (as dropped-oldest overruns once the ring saturates, and/or fill offset).
    const double accrued = off.finalFillErrorMs +
                           static_cast<double>(off.overruns) * kCapacity / oneMsFrames;
    CHECK(accrued > 10.0); // an order past the 1 ms the controller holds

    std::printf("asrc_drift_test OK\n");
    return 0;
}
