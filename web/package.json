{
  "name": "wizard-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "bundle": "tsc --noEmit && vite build --outDir ../webdist --emptyOutDir && node --experimental-strip-types scripts/webdistFresh.ts --write",
    "webdist:check": "node --experimental-strip-types scripts/webdistFresh.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "protocol:generate": "node --experimental-strip-types scripts/generate-protocol.ts",
    "protocol:check": "node --experimental-strip-types scripts/generate-protocol.ts --check",
    "abi:check": "node --experimental-strip-types scripts/checkAbiCoverage.ts",
    "check:tokens": "node --experimental-strip-types scripts/check-tokens.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
